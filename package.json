{
  "name": "score",
  "description": "score: football player trading protocol on Solana (devnet demo, mock protocol)",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.2.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "demo:loop": "node scripts/demo-loop.mjs",
    "anchor-build": "cd anchor && anchor build --ignore-keys",
    "anchor-test": "cd anchor && anchor build --ignore-keys && cargo test",
    "codama:js": "codama run js",
    "setup": "bun run anchor-build && bun run codama:js"
  },
  "dependencies": {
    "@score/core": "workspace:*",
    "@solana/kit": "^6.3.0",
    "@solana/kit-client-rpc": "^0.7.0",
    "@solana/kit-plugin-rpc": "^0.7.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@tanstack/react-query": "^5.105.1",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
    "swr": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codama/nodes-from-anchor": "1.5.3",
    "@codama/renderers-js": "1.7.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "codama": "1.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "fast-check": "^4.10.2",
    "playwright": "1.64.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
