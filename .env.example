# Copy to .env.local and fill in. .env.local is gitignored.
# Devnet RPC (e.g. Helius). NEXT_PUBLIC_ values are bundled into the browser, so use a key restricted to your domains.
NEXT_PUBLIC_SOLANA_RPC_DEVNET=
# Privy: app id (public) and app secret (server-only, used by the oracle's faucet).
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Backend URLs. Unset = the app runs on the in-browser mock.
NEXT_PUBLIC_SCORE_NODE=
NEXT_PUBLIC_SCORE_ORACLE=
